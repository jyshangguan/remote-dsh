{
  "name": "dsh-remote-panel-openssh",
  "version": "0.1.0",
  "private": true,
  "description": "在桌面端 DSH 内通过 OpenSSH 直连嵌入远端完整 DSH 界面：安全接管、侧装匹配运行时、绝不静默重启。Embed the full remote DSH GUI in Desktop over OpenSSH: safe attach, side-installed runtime, no silent restarts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.svg",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ssh",
    "openssh",
    "sftp",
    "remote",
    "panel"
  ],
  "license": "Apache-2.0",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyshangguan/dsh-remote-panel-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/jyshangguan/dsh-remote-panel-ssh/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  }
}